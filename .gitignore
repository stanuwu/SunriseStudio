# Build output. The root obj/ also holds the publish build.
bin/
obj/
/publish/

# The .NET home and package cache the scripts keep here, and local tool sources.
/.dotnet/
/.nuget/
/.tools/

# Editor settings.
.vs/
.idea/
.vscode/
*.user

# Python caches from the Blender check scripts.
__pycache__/
*.py[cod]

# Local captures, logs and scratch.
/captures/
/logs/
/.local/

# Game data (Phase 01). Nothing from a game installation is committed.
*.pkg
*.bin
*.bik
*.wem
*.bnk
*.pck
*.usm
oo2core*.dll
package_keys*
destiny*.exe
# Extracted dumps.
/dumps/
/extracted/
/unpacked/
/rip/
/exports/
# Studio's own generated codebook table (packed from libvorbis/aoTuV books), not game data.
!src/SunriseStudio.Audio/Resources/wwise-vorbis-codebooks.bin
