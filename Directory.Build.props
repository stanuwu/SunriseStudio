<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>13.0</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Deterministic>true</Deterministic>
    <!-- Studio's release version; every assembly carries it. -->
    <Version>0.1.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <RestorePackagesPath>$(MSBuildThisFileDirectory).nuget/packages</RestorePackagesPath>
  </PropertyGroup>
  <!-- Solforge Phase 02. The src projects built with zero warnings (2026-10-15), so new warnings fail
       the build there. NuGet audit advisories stay warnings: a new advisory must not break old commits.
       The check programs under tests/ are left alone. -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Contains('\src\SunriseStudio.'))">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>
  <!-- CI builds map source paths too, so the same commit gives byte-identical assemblies anywhere. -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
