          { "name": "table_tag", "cs": "Table", "type": "u32" },
          { "name": "descriptor_offset", "cs": "Descriptor", "type": "u32" },
          { "name": "stock_count", "type": "u32" },
          { "name": "mod_count", "type": "u32", "doc": "This mod's final row count." }
        ] },
      { "id": "shape_header", "cs": "SidecarShapeHeader", "cpp": "ShapeHeader", "cs_size": "ShapeHeaderSize",
        "doc": "Row layout header; its fields follow it.",
        "fields": [
          { "name": "stride", "type": "u32" },
          { "name": "field_count", "type": "u32" }
        ] },
      { "id": "shape_field", "cs": "SidecarShapeField", "cpp": "ShapeField", "cs_size": "ShapeFieldSize", "public": true,
        "doc": "One pointer-bearing field of a row.",
        "fields": [
          { "name": "row_offset", "type": "u32" },
          { "name": "kind", "type": "field_kind" },
          { "name": "reserved", "type": "u8", "reserved": true },
          { "name": "ref", "type": "u16",
            "doc": "Op of a row pointer; shape of an owned array's elements or of an object, or none." }
        ] },
      { "id": "entry_header", "cs": "SidecarEntryHeader", "cpp": "EntryHeader", "cs_size": "EntryHeaderSize",
        "doc": "One entry's merge description; diffs, ops and sites follow it.",
        "fields": [
          { "name": "entry_index", "cs": "Index", "type": "u32" },
          { "name": "kind", "type": "entry_kind" },
          { "name": "reserved", "type": "u8", "count": 3, "reserved": true },
          { "name": "stock_size", "type": "u32" },
          { "name": "built_size", "type": "u32", "doc": "Must equal the entry's size in the package." },
          { "name": "stock_sha256", "type": "byte", "count": "sha256_size" },
          { "name": "diff_count", "type": "u32" },
          { "name": "op_count", "type": "u32" },
          { "name": "site_count", "type": "u32" },
          { "name": "reserved2", "type": "u32", "reserved": true }
        ] },
      { "id": "diff_header", "cs": "SidecarDiffHeader", "cpp": "DiffHeader", "cs_size": "DiffHeaderSize",
        "doc": "One changed stock range; its old bytes follow it.",
        "fields": [
          { "name": "offset", "type": "u32" },
          { "name": "length", "type": "u32" }
        ] },
      { "id": "op", "cs": "SidecarOp", "cpp": "OpRecord", "cs_size": "OpSize", "public": true,
        "doc": "One typed array the merge rebuilds.",
        "fields": [
          { "name": "kind", "type": "op_kind" },
          { "name": "flags", "type": "u8" },
          { "name": "key_width", "type": "u8", "doc": "0, or 4 for a u32 key." },
          { "name": "reserved", "type": "u8", "reserved": true },
          { "name": "key_offset", "type": "u32" },
          { "name": "parent_op", "type": "u32", "doc": "kTopLevelOp, or the op whose row holds this descriptor." },
          { "name": "parent_row", "type": "u32" },
          { "name": "descriptor_offset", "cs": "Descriptor", "type": "u32",
            "doc": "Entry offset at top level, else offset inside the parent row." },
          { "name": "shape", "type": "u32" },
          { "name": "stock_count", "type": "u32" },
          { "name": "mod_count", "type": "u32" },
          { "name": "limit", "type": "u32", "doc": "Largest allowed merged count." },
          { "name": "pair_group", "type": "u32", "doc": "0, or the id shared by tables whose rows are added in step." }
        ] },
      { "id": "site", "cs": "SidecarSite", "cpp": "SiteRecord", "cs_size": "SiteSize", "public": true,
        "doc": "One field that holds the number of a row this mod added.",
        "fields": [
          { "name": "offset", "type": "u32" },
          { "name": "width", "type": "u8", "doc": "1, 2 or 4 bytes." },
          { "name": "flags", "type": "u8" },
          { "name": "target", "type": "u16", "doc": "A targets[] index, or kOpLocalTarget | op." }
        ] }
    ]
  },
