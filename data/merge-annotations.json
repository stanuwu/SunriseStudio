{
  "format": "sunrise-merge-annotations",
  "version": 1,
  "sidecar": {
    "constants": [
      { "id": "magic", "cs": "Magic", "cpp": "kSidecarMagic", "type": "u32", "value": "0x47524D53",
        "doc": "The bytes 'S','M','R','G' read as a little-endian u32." },
      { "id": "version", "cs": "Version", "cpp": "kSidecarVersion", "type": "u16", "value": 3,
        "doc": "Any layout change bumps this; other versions are ignored." },
      { "id": "oldest_version", "cs": "OldestVersion", "cpp": "kOldestSidecarVersion", "type": "u16", "value": 2,
        "doc": "Version 2 is version 3 without object shapes, so it still reads." },
      { "id": "byte_limit", "cs": "ByteLimit", "cpp": "kSidecarByteLimit", "type": "size", "value": "64 << 20",
        "doc": "Bound on one sidecar file, so a damaged file cannot exhaust memory." },
      { "id": "top_level_op", "cs": "TopLevelOp", "cpp": "kTopLevelOp", "type": "u32", "value": "0xFFFFFFFF",
        "doc": "OpRecord::parentOp value of an op that sits directly in the entry." },
      { "id": "no_element_shape", "cs": "NoElementShape", "cpp": "kNoElementShape", "type": "u16", "value": "0xFFFF",
        "doc": "ShapeField::ref value of an owned array whose elements hold no pointers." },
      { "id": "op_local_target", "cs": "OpLocalTarget", "cpp": "kOpLocalTarget", "type": "u16", "value": "0x8000",
        "doc": "SiteRecord::target bit that names an op of the same entry instead of a target." },
      { "id": "unique_key", "cs": "UniqueKey", "cpp": "kUniqueKey", "type": "u8", "value": "0x01",
        "doc": "OpRecord::flags bit: no two merged rows may share a key." },
      { "id": "ordered", "cs": "Ordered", "cpp": "kOrdered", "type": "u8", "value": "0x02",
        "doc": "OpRecord::flags bit: merged keys must stay strictly ascending." },
      { "id": "signed_site", "cs": "SignedSite", "cpp": "kSignedSite", "type": "u8", "value": "0x01",
        "doc": "SiteRecord::flags bit: the site value is signed." },
      { "id": "key_width", "cs": "KeyWidth", "cpp": "kKeyWidth", "type": "u8", "value": 4,
        "doc": "Bytes of a u32 key, the only key width." },
      { "id": "byte_site", "cs": "ByteSite", "cpp": "kByteSite", "type": "u8", "value": 1,
        "doc": "Width of a site that holds a u8 row number." },
      { "id": "short_site", "cs": "ShortSite", "cpp": "kShortSite", "type": "u8", "value": 2,
        "doc": "Width of a site that holds a u16 row number." },
      { "id": "word_site", "cs": "WordSite", "cpp": "kWordSite", "type": "u8", "value": 4,
        "doc": "Width of a site that holds a u32 row number." },
      { "id": "digest_size", "cs": "DigestSize", "cpp": "kSidecarDigestSize", "type": "size", "value": 20,
        "doc": "Bytes of the package header digest a sidecar is bound to." },
      { "id": "sha256_size", "cs": "Sha256Size", "cpp": "kStockDigestSize", "type": "size", "value": 32,
        "doc": "Bytes of one SHA-256 digest." }
    ],
    "enums": [
      { "id": "entry_kind", "cs": "SidecarEntryKind", "cpp": "EntryKind", "type": "u8",
        "doc": "How the runtime may merge one entry.",
        "values": [
          { "name": "opaque", "value": 0 },
          { "name": "table", "value": 1 },
          { "name": "manifest", "value": 2 },
          { "name": "added", "value": 3 }
        ] },
      { "id": "field_kind", "cs": "MergeFieldKind", "cpp": "FieldKind", "type": "u8",
        "doc": "How a row field holds a pointer.",
        "values": [
          { "name": "owned_array", "value": 1, "bytes": 16, "doc": "A 16-byte typed array descriptor {i64 count, i64 rel}." },
          { "name": "row_pointer", "value": 2, "bytes": 8, "doc": "An 8-byte self-relative pointer to a row start." },
          { "name": "object_pointer", "value": 3, "bytes": 8,
            "doc": "An 8-byte self-relative pointer to an object outside every rebuilt array." }
        ] },
      { "id": "op_kind", "cs": "MergeOpKind", "cpp": "OpKind", "type": "u8",
        "doc": "How one op's rows merge.",
        "values": [
          { "name": "append", "value": 1 },
          { "name": "sorted_map", "value": 2 }
        ] }
    ],
    "records": [
      { "id": "file_header", "cs": "SidecarFileHeader", "cpp": "FileHeader", "cs_size": "HeaderSize",
