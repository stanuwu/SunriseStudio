          { "name": "shape_count", "type": "u32" },
          { "name": "entry_count", "type": "u32" },
          { "name": "reserved", "type": "u32", "reserved": true }
        ] },
      { "id": "target", "cs": "SidecarTarget", "cpp": "TargetRecord", "cs_size": "TargetSize", "public": true,
