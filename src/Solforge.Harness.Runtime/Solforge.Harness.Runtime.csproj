<Project Sdk="Microsoft.NET.Sdk">
  <!-- Solforge (UI-UE5 §5.4): staged model workflows (HarnessWorkflowService) and their worker adapters, ported from
       solforge-next's Solforge.Next.Harness.Runtime. Editor access goes through IEditorGateway (four operations over
       ISolforgeHost), replacing solforge-next's named-pipe EditorBridgeClient. No OpenCode adapter, no MCP SDK. Nothing
       here runs on its own: a workflow starts only after the user confirms it in the editor. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Solforge.Harness.Runtime</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Solforge.Harness/Solforge.Harness.csproj" />
    <ProjectReference Include="../Solforge.Mcp/Solforge.Mcp.csproj" />
  </ItemGroup>
</Project>
