<Project Sdk="Microsoft.NET.Sdk">
  <!-- Solforge (UI-UE5 §4.1, §5.1): finds, launches, focuses and stops the separate Solforge AI desktop app (Electron, from
       solforge-next) per solforge-next/ai/README-runtime.md, "Launch contract for the C# side". Ported from solforge-next's
       SolforgeAiHost. Only the process started here is ever focused, stopped or killed. net9.0-windows for the named-pipe
       server PID check and the window focus fallback (kernel32/user32). -->
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RootNamespace>Solforge.AiLauncher</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Solforge.Harness/Solforge.Harness.csproj" />
  </ItemGroup>
</Project>
