<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets/Sunrise.png" LogicalName="SunriseStudio.Logo" />
    <EmbeddedResource Include="Assets/Sunrise.ico" LogicalName="SunriseStudio.Icon" />
    <EmbeddedResource Include="Assets/Sol/emblem-gold-mask.png" LogicalName="Solforge.EmblemGold" />
    <EmbeddedResource Include="Assets/Sol/emblem-mark.png" LogicalName="Solforge.EmblemMark" />
    <EmbeddedResource Include="../../THIRD_PARTY.md" LogicalName="SunriseStudio.Notices.Studio" />
    <EmbeddedResource Include="../../licenses/dotnet-runtime.txt" LogicalName="SunriseStudio.Notices.DotNet" />
    <EmbeddedResource Include="../../licenses/community-toolkit.txt" LogicalName="SunriseStudio.Notices.Toolkit" />
    <EmbeddedResource Include="../../licenses/chakra-petch-OFL.txt" LogicalName="SunriseStudio.Notices.ChakraPetch" />
    <EmbeddedResource Include="../../licenses/inter-OFL.txt" LogicalName="SunriseStudio.Notices.Inter" />
    <ProjectReference Include="../SunriseStudio.Packages/SunriseStudio.Packages.csproj" />
    <ProjectReference Include="../SunriseStudio.Projects/SunriseStudio.Projects.csproj" />
    <ProjectReference Include="../SunriseStudio.Formats/SunriseStudio.Formats.csproj" />
    <ProjectReference Include="../SunriseStudio.Authoring/SunriseStudio.Authoring.csproj" />
    <ProjectReference Include="../SunriseStudio.Interchange/SunriseStudio.Interchange.csproj" />
    <ProjectReference Include="../SunriseStudio.Missions/SunriseStudio.Missions.csproj" />
    <ProjectReference Include="../SunriseStudio.Live/SunriseStudio.Live.csproj" />
    <ProjectReference Include="../SunriseStudio.Audio/SunriseStudio.Audio.csproj" />
    <ProjectReference Include="../SunriseStudio.Viewport/SunriseStudio.Viewport.csproj" />
    <ProjectReference Include="../Solforge.Mcp/Solforge.Mcp.csproj" />
    <ProjectReference Include="../Solforge.Content/Solforge.Content.csproj" />
    <ProjectReference Include="../Solforge.Graphs/Solforge.Graphs.csproj" />
    <!-- Retail workspace: live-build dump reader, retail map viewer and porting (read-only towards game packages). -->
    <ProjectReference Include="../Solforge.Retail/Solforge.Retail.csproj" />
    <!-- UI-UE5 §5 (agent C): the Solforge AI launcher, model role routing / credential rules / shared-resources preflight,
         and the workflow runtime ported from solforge-next. -->
    <ProjectReference Include="../Solforge.AiLauncher/Solforge.AiLauncher.csproj" />
    <ProjectReference Include="../Solforge.Harness/Solforge.Harness.csproj" />
    <ProjectReference Include="../Solforge.Harness.Runtime/Solforge.Harness.Runtime.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- UI-UE5 §4.2: the removed AI console (ConPty terminal, VT screen, selection, paste) no longer ships in Solforge.exe;
         tests/SunriseStudio.Editor.Tests compiles these files itself so TerminalChecks keep running. -->
    <Compile Remove="Ai/**" />
  </ItemGroup>
  <ItemGroup>
    <!-- The bundled solforge-model-workflow skill: Solforge AI's shared-skills row and the preflight read it beside the exe. -->
    <None Update="Integrations/skills/**/*.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
