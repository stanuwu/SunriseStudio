<Project Sdk="Microsoft.NET.Sdk">
  <!-- Solforge Phase 47B: the local MCP server, tools, attention log and client configs (Studio.md §3.8).
       Plain net9.0 with no Windows or ASP.NET dependencies, so the shim and the checks can use it. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Solforge.Mcp</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- Content documents (subclasses, loot pools...): the content tools read and write them in the project folder. -->
    <ProjectReference Include="../Solforge.Content/Solforge.Content.csproj" />
    <ProjectReference Include="../Solforge.Graphs/Solforge.Graphs.csproj" />
    <!-- Tag schema registry and decoders behind the game table tools. -->
    <ProjectReference Include="../SunriseStudio.Packages/SunriseStudio.Packages.csproj" />
    <!-- Retail (live build 245048) dump reader, decoders and porting behind the retail_* tools. -->
    <ProjectReference Include="../Solforge.Retail/Solforge.Retail.csproj" />
    <!-- UI-UE5 §5.3: the credential-document guard (CredentialGuard, FileIdentity) and the shared-resources preflight the
         standalone descriptor (solforge-ai-mcp.json) is written from. Plain net9.0, no further references. -->
    <ProjectReference Include="../Solforge.Harness/Solforge.Harness.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- UI-UE5 §4.2: console-only helpers (terminal allow-prompt reader, console list and quota detection) are no longer
         shipped; tests/SunriseStudio.Mcp.Tests compiles them for its checks. -->
    <Compile Remove="ApprovalPrompts.cs;AiConsoleAdapters.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Screen OCR helper (Windows.Media.Ocr through Windows PowerShell 5.1); ScreenOcr writes it to %TEMP% and runs it. -->
    <EmbeddedResource Include="ScreenOcr.ps1" LogicalName="Solforge.Mcp.ScreenOcr.ps1" />
  </ItemGroup>
</Project>
